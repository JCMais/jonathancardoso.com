# Global pnpm config enforces minimum-release-age=4320 (3 days) as supply-chain hygiene.
# The Astro 7 packages below were published 2026-08-31 and were already installed, built,
# and inspected on 2026-09-01; they are excluded here and pinned exactly in package.json.
# Remove these lines after 2026-09-04 when they are mature on their own.
minimum-release-age-exclude[]=astro
minimum-release-age-exclude[]=@astrojs/*
minimum-release-age-exclude[]=astro-expressive-code
minimum-release-age-exclude[]=rehype-expressive-code
minimum-release-age-exclude[]=expressive-code
minimum-release-age-exclude[]=@expressive-code/*
