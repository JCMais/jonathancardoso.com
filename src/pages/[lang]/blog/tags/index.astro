---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHeading from '@/components/PageHeading.astro'
import TermList from '@/components/TermList.astro'
import { LOCALES, useTranslations, type Locale } from '@/i18n/ui'
import { getPublishedPostsForLocale, collectTags, tagsUrl, tagUrl } from '@/lib/posts'

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }))
}

const locale = Astro.params.lang as Locale
const t = useTranslations(locale)
const tags = collectTags(await getPublishedPostsForLocale(locale))
---

<BaseLayout locale={locale} title={t('tags.title')} alternates={{ en: tagsUrl('en'), 'pt-br': tagsUrl('pt-br') }}>
  <div class="wrap-page">
    <PageHeading title={t('tags.title')} />
    <TermList terms={tags} locale={locale} icon="tag" urlFor={(slug) => tagUrl(locale, slug)} />
  </div>
</BaseLayout>

<style>
  .wrap-page {
    width: min(100% - 2.5rem, 56rem);
    margin-inline: auto;
  }
</style>
