---
// One icon system: 24-unit grid, 1.5px stroke, round joins. Paths follow the Lucide
// conventions so every glyph reads at the same weight.
export type IconName =
  | 'search'
  | 'sun'
  | 'moon'
  | 'mail'
  | 'github'
  | 'linkedin'
  | 'x'
  | 'rss'
  | 'arrow-right'
  | 'arrow-up-right'
  | 'arrow-left'
  | 'chevron-right'
  | 'corner-down-left'
  | 'globe'
  | 'info'
  | 'hash'
  | 'folder'
  | 'tag'
  | 'command'
  | 'check'
  | 'git-branch'
  | 'pen'
  | 'clock'
  | 'calendar'
  | 'users'
  | 'file-text'
  | 'list'
  | 'home'
  | 'devto'
  | 'external'
  | 'lamp'

interface Props {
  name: IconName
  size?: number | string
  class?: string
  label?: string
}

const { name, size = 16, class: className, label } = Astro.props

const paths: Record<IconName, string> = {
