---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Icon from '@/components/Icon.astro'
import { useTranslations, type Locale } from '@/i18n/ui'
import { blogUrl } from '@/lib/posts'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = useTranslations(locale)
---

<BaseLayout locale={locale} title={t('notFound.title')} alternates={{ en: '/en/404/', 'pt-br': '/pt-br/404/' }} noindex>
  <section class="nf wrap-content">
    <p class="nf-code mono">404</p>
    <h1 class="nf-title">{t('notFound.title')}</h1>
    <p class="nf-body">{t('notFound.body')}</p>
    <div class="nf-actions">
      <a class="btn btn-primary" href={`/${locale}/`}><Icon name="home" size={15} />{t('notFound.home')}</a>
      <a class="btn" href={blogUrl(locale)}><Icon name="pen" size={15} />{t('nav.writing')}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding: 6rem 0 4rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }
  .nf-code {
    font-size: 0.875rem;
    color: var(--accent-strong);
  }
  .nf-title {
    font-size: clamp(1.9rem, 4vw, 2.75rem);
    letter-spacing: -0.03em;
  }
  .nf-body {
    color: var(--text-2);
    max-width: 44ch;
    text-wrap: pretty;
  }
  .nf-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
</style>
