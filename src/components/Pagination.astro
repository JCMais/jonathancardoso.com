---
import Icon from './Icon.astro'
import { useTranslations, type Locale } from '@/i18n/ui'

interface Props {
  locale: Locale
  current: number
  total: number
  urlFor: (page: number) => string
}
const { locale, current, total, urlFor } = Astro.props
const t = useTranslations(locale)
---

{
  total > 1 && (
    <nav class="pagination" aria-label="Pagination">
      {current > 1 ? (
        <a class="btn btn-sm" href={urlFor(current - 1)} rel="prev">
          <Icon name="arrow-left" size={14} />
          {t('blog.newer')}
        </a>
      ) : (
        <span />
      )}
      <span class="pagination-info tabular">{t('blog.page', { n: current, total })}</span>
      {current < total ? (
        <a class="btn btn-sm" href={urlFor(current + 1)} rel="next">
          {t('blog.older')}
          <Icon name="arrow-right" size={14} />
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}

<style>
  .pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
  }
  .pagination > :last-child {
    justify-self: end;
  }
  .pagination-info {
    font-size: 0.8125rem;
    color: var(--text-2);
  }
</style>
