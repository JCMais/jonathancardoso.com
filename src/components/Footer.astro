---
import Icon from './Icon.astro'
import { useTranslations, type Locale } from '@/i18n/ui'
import { SITE } from '@/lib/site'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = useTranslations(locale)
const year = new Date().getFullYear()
---

<footer class="footer">
  <div class="wrap footer-inner">
    <p class="copy">
      <span class="tabular">© {year}</span> {t('footer.rights')}
    </p>
    <nav class="links" aria-label="Footer">
      <a href={SITE.social.github.url} rel="me noopener" target="_blank"><Icon name="github" size={15} />{SITE.social.github.label}</a>
      <a href={SITE.social.linkedin.url} rel="me noopener" target="_blank"><Icon name="linkedin" size={15} />{SITE.social.linkedin.label}</a>
      <a href={SITE.social.x.url} rel="me noopener" target="_blank"><Icon name="x" size={15} />{SITE.social.x.label}</a>
      <a href={`/${locale}/rss.xml`}><Icon name="rss" size={15} />{t('footer.rss')}</a>
      <a href={`/${locale}/privacy/`}>{t('footer.privacy')}</a>
    </nav>
    <p class="built">
      <a href={SITE.repo} rel="noopener" target="_blank">{t('footer.madeWith')}<Icon name="arrow-up-right" size={13} /></a>
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    background: var(--bg-elev);
    padding: 1.5rem 0;
    font-size: 0.875rem;
    color: var(--text-2);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.25rem;
  }
  .links a,
  .built a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 1.9rem;
    padding: 0 0.55rem;
    border-radius: var(--radius-s);
    transition:
      color var(--t-fast) var(--ease-out),
      background var(--t-fast) var(--ease-out);
  }
  .links a:hover,
  .built a:hover {
    color: var(--text);
    background: var(--surface-2);
  }
  .built a {
    padding-right: 0.3rem;
  }
  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
