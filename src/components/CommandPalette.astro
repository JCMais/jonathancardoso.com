---
import Icon from './Icon.astro'
import { otherLocale, useTranslations, type Locale } from '@/i18n/ui'
import { blogUrl, categoriesUrl, tagsUrl } from '@/lib/posts'

interface Props {
  locale: Locale
  alternates: Partial<Record<Locale, string>>
  posts: { title: string; url: string; date: string; tags: string[] }[]
}
const { locale, alternates, posts } = Astro.props
const t = useTranslations(locale)
const other = otherLocale(locale)
const switchHref = alternates[other] ?? `/${other}/`

const pages = [
  { label: t('nav.home'), href: `/${locale}/`, icon: 'home' as const },
  { label: t('nav.writing'), href: blogUrl(locale), icon: 'pen' as const },
  { label: t('nav.categories'), href: categoriesUrl(locale), icon: 'folder' as const },
  { label: t('nav.tags'), href: tagsUrl(locale), icon: 'tag' as const },
]
---

<dialog class="cmdk" data-cmdk aria-label={t('nav.search')}>
  <form method="dialog" class="cmdk-box" data-cmdk-form>
    <div class="cmdk-head">
      <Icon name="search" size={16} class="cmdk-search-icon" />
      <input
        type="text"
        class="cmdk-input"
        data-cmdk-input
        placeholder={t('cmdk.placeholder')}
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        aria-label={t('nav.search')}
        aria-controls="cmdk-list"
        aria-activedescendant=""
        role="combobox"
        aria-expanded="true"
      />
      <button type="button" class="kbd cmdk-esc" data-cmdk-close aria-label={t('cmdk.close')}>esc</button>
    </div>

    <div class="cmdk-list" id="cmdk-list" role="listbox" data-cmdk-list>
      <div class="cmdk-group" data-group>
        <div class="cmdk-group-title">{t('cmdk.posts')}</div>
        {
          posts.map((p) => (
            <a class="cmdk-item" role="option" aria-selected="false" href={p.url} data-item data-kw={`${p.title} ${p.tags.join(' ')} ${p.date}`.toLowerCase()}>
              <Icon name="file-text" size={15} />
              <span class="cmdk-item-label">{p.title}</span>
              <span class="cmdk-item-meta mono">{p.date}</span>
            </a>
          ))
        }
      </div>
      <div class="cmdk-group" data-group>
        <div class="cmdk-group-title">{t('cmdk.pages')}</div>
        {
          pages.map((p) => (
            <a class="cmdk-item" role="option" aria-selected="false" href={p.href} data-item data-kw={p.label.toLowerCase()}>
              <Icon name={p.icon} size={15} />
              <span class="cmdk-item-label">{p.label}</span>
            </a>
          ))
        }
      </div>
      <div class="cmdk-group" data-group>
        <div class="cmdk-group-title">{t('cmdk.actions')}</div>
        <button type="button" class="cmdk-item" role="option" aria-selected="false" data-item data-action="theme" data-kw={`${t('cmdk.toggleTheme')} dark light theme`.toLowerCase()}>
          <Icon name="sun" size={15} />
          <span class="cmdk-item-label">{t('cmdk.toggleTheme')}</span>
        </button>
        <a class="cmdk-item" role="option" aria-selected="false" href={switchHref} data-item data-kw={`${t('cmdk.switchLang')} language idioma english português`.toLowerCase()}>
          <Icon name="globe" size={15} />
          <span class="cmdk-item-label">{t('cmdk.switchLang')}</span>
        </a>
      </div>
      <div class="cmdk-empty" data-empty hidden>{t('cmdk.noResults')}</div>
    </div>

    <div class="cmdk-foot" aria-hidden="true">
      <span><span class="kbd">↑</span><span class="kbd">↓</span> {t('cmdk.navigate')}</span>
      <span><span class="kbd">↵</span> {t('cmdk.select')}</span>
    </div>
  </form>
</dialog>

<style>
  .cmdk {
    position: fixed;
    inset: 0;
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    border: 0;
    background: transparent;
    color: var(--text);
    display: none;
    place-items: start center;
    padding-top: min(18vh, 10rem);
    z-index: 60;
  }
  .cmdk[open] {
    display: grid;
  }
  .cmdk::backdrop {
    background: rgba(8, 9, 12, 0.55);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  :global([data-theme='light']) .cmdk::backdrop {
    background: rgba(20, 21, 24, 0.28);
  }
  .cmdk-box {
    width: min(100% - 2rem, 36rem);
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-l);
    box-shadow:
      inset 0 1px 0 var(--line-top),
      var(--shadow-2);
    overflow: hidden;
    transform-origin: top center;
    animation: cmdk-in var(--t-base) var(--ease-out);
  }
  @keyframes cmdk-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .cmdk-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 0.875rem 0 1rem;
    height: 3.25rem;
    border-bottom: 1px solid var(--line);
    color: var(--text-2);
  }
  .cmdk-input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    background: transparent;
    outline: 0;
    font-size: 1rem;
    color: var(--text);
  }
  .cmdk-input::placeholder {
    color: var(--text-3);
  }
  .cmdk-esc {
    height: 1.4rem;
    padding: 0 0.4rem;
    cursor: pointer;
  }
  .cmdk-list {
    max-height: min(52vh, 24rem);
    overflow-y: auto;
    padding: 0.4rem;
    scrollbar-width: thin;
  }
  .cmdk-group[hidden] {
    display: none;
  }
  .cmdk-group-title {
    padding: 0.55rem 0.6rem 0.3rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-3);
  }
  .cmdk-item {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: 100%;
    padding: 0 0.6rem;
    height: 2.4rem;
    border-radius: var(--radius-s);
    color: var(--text);
    font-size: 0.9375rem;
    text-align: left;
    cursor: pointer;
    transition: background var(--t-fast) var(--ease-out);
  }
  .cmdk-item[hidden] {
    display: none;
  }
  .cmdk-item :global(svg) {
    color: var(--text-2);
  }
  .cmdk-item-label {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cmdk-item-meta {
    font-size: 0.75rem;
    color: var(--text-3);
  }
  .cmdk-item[aria-selected='true'] {
    background: var(--surface-3);
  }
  .cmdk-item[aria-selected='true'] :global(svg) {
    color: var(--accent-strong);
  }
  .cmdk-empty {
    padding: 1.5rem 0.75rem;
    text-align: center;
    color: var(--text-2);
    font-size: 0.9375rem;
  }
  .cmdk-foot {
    display: flex;
    gap: 1.25rem;
    padding: 0.55rem 1rem;
    border-top: 1px solid var(--line);
    background: var(--surface-2);
    color: var(--text-3);
    font-size: 0.75rem;
  }
  .cmdk-foot span {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-cmdk]')
  if (dialog) {
    const input = dialog.querySelector<HTMLInputElement>('[data-cmdk-input]')!
    const list = dialog.querySelector<HTMLElement>('[data-cmdk-list]')!
    const empty = dialog.querySelector<HTMLElement>('[data-empty]')!
    const groups = [...dialog.querySelectorAll<HTMLElement>('[data-group]')]
    const items = [...dialog.querySelectorAll<HTMLElement>('[data-item]')]
    items.forEach((el, i) => (el.id = `cmdk-opt-${i}`))
    let cursor = 0

    const visible = () => items.filter((el) => !el.hidden)

    const select = (i: number) => {
      const v = visible()
      if (!v.length) return
      cursor = (i + v.length) % v.length
      items.forEach((el) => el.setAttribute('aria-selected', 'false'))
      const el = v[cursor]
      el.setAttribute('aria-selected', 'true')
      input.setAttribute('aria-activedescendant', el.id)
      el.scrollIntoView({ block: 'nearest' })
    }

    const filter = () => {
      const q = input.value.trim().toLowerCase()
      const words = q.split(/\s+/).filter(Boolean)
      items.forEach((el) => {
        const kw = el.dataset.kw ?? ''
        el.hidden = words.length > 0 && !words.every((w) => kw.includes(w))
      })
      groups.forEach((g) => (g.hidden = ![...g.querySelectorAll<HTMLElement>('[data-item]')].some((el) => !el.hidden)))
      empty.hidden = visible().length > 0
      select(0)
    }

    const open = () => {
      if (dialog.open) return
      dialog.showModal()
      input.value = ''
      filter()
      requestAnimationFrame(() => input.focus())
    }
    const close = () => dialog.open && dialog.close()

    const activate = (el: HTMLElement) => {
      if (el.dataset.action === 'theme') {
        document.querySelector<HTMLButtonElement>('[data-theme-toggle]')?.click()
        close()
        return
      }
      const href = el.getAttribute('href')
      if (href) window.location.href = href
    }

    document.querySelectorAll('[data-cmdk-open]').forEach((b) => b.addEventListener('click', open))
    dialog.querySelector('[data-cmdk-close]')?.addEventListener('click', close)
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close()
    })
    dialog.querySelector('[data-cmdk-form]')?.addEventListener('submit', (e) => {
      e.preventDefault()
      const v = visible()
      if (v[cursor]) activate(v[cursor])
    })
    input.addEventListener('input', filter)
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault()
        select(cursor + 1)
      } else if (e.key === 'ArrowUp') {
        e.preventDefault()
        select(cursor - 1)
      }
    })
    items.forEach((el, i) => {
      el.addEventListener('mousemove', () => {
        const v = visible()
        const idx = v.indexOf(el)
        if (idx !== -1 && idx !== cursor) select(idx)
      })
      el.addEventListener('click', (e) => {
        if (el.dataset.action) {
          e.preventDefault()
          activate(el)
        }
      })
      void i
    })
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault()
        dialog.open ? close() : open()
      } else if (e.key === '/' && !dialog.open && !(e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement)) {
        e.preventDefault()
        open()
      }
    })
    if (!/Mac|iPhone|iPad/.test(navigator.platform)) {
      document.querySelectorAll('.search-keys .kbd').forEach((k) => {
        if (k.textContent === '⌘') k.textContent = 'Ctrl'
      })
    }
  }
</script>
